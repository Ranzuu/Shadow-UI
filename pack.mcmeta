{
  "pack": {
    "pack_format": 1,
    "description": "§8GTNH v2.9.X §f/ §3Pack v5.0 §aby Ranzu"
  },
  "gtnh_resource_pack_updater": {
    "schema": 1,
    "pack_name": "ShadowUI",
    "pack_version": "5.0",
    "pack_game_version": "2.9.X",
    "source": {
      "type": "github_releases",
      "owner": "Ranzuu",
      "repo": "Shadow-UI"
    }
  },
  "dark_mode_utils": {
    "schema": 1,
    "target": {
      "gui_font": {
        "input": {
          "minimum": "0x606666",
          "maximum": "0xBEBEBE"
        },
        "output": "0xBFBFBF",
        "shadow": true
      },
      "button_font": {
        "enabled": {
          "output": "0xBFBFBF"
        },
        "hovered": {
          "output": "0xEFC62F"
        },
        "disabled": {
          "output": "0x888888"
        }
      },
      "shadows_global": true
    }
  }
}
